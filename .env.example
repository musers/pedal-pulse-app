# ==============================================================================
# VeloRide India - Environment Configuration Variables
# Pass these via --dart-define or Supabase Secrets
# ==============================================================================

# Supabase (PostgreSQL, Auth & Storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay (Indian Payments: UPI, Cards, Netbanking)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# MSG91 (Indian Transactional SMS & OTPs)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_msg91_dlt_template_id

# Resend (Transactional Email Receipts & Tax Invoices)
RESEND_API_KEY=re_your_resend_api_key

# Google Maps Platform (Hub Geocoding & Distance Matrix)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
